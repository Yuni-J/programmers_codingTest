package programmers01;

public class Lv0_75 {
	// 길이에 따른 연산
	
    public int solution(int[] num_list) {
        int answer = 0;
        int len = num_list.length;
        
        if(len >= 11){
            for(int num : num_list){
                answer += num;
            }
        } else {
            answer = 1;
            for(int num : num_list){
                answer *= num;
            }
        }
        
        return answer;
    }
}