/* 입양 시각 구하기(2) */

WITH RECURSIVE HOURS AS (
    SELECT 0 AS HOUR
    UNION ALL
    SELECT HOUR + 1
    FROM HOURS
    WHERE HOUR < 23
)

SELECT
    H.HOUR AS HOUR
    , COUNT(A.DATETIME) AS COUNT
FROM HOURS AS H
LEFT JOIN ANIMAL_OUTS AS A
    ON HOUR(A.DATETIME) = H.HOUR
GROUP BY H.HOUR
ORDER BY H.HOUR;